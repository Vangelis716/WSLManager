<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WSL Manager" Height="720" Width="1240" MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ToolSep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,5">
            <WrapPanel>
                <Button x:Name="btnNewOnline" Style="{StaticResource ToolButton}" Content="➕ New (online)" ToolTip="Install a distribution from the online catalog"/>
                <Button x:Name="btnClone" Style="{StaticResource ToolButton}" Content="⧉ Clone" ToolTip="Clone the selected/another instance"/>
                <Button x:Name="btnImport" Style="{StaticResource ToolButton}" Content="📂 Import VHDX" ToolTip="Register an existing .vhdx in place"/>
                <Border Style="{StaticResource ToolSep}"/>
                <Button x:Name="btnStart" Style="{StaticResource ToolButton}" Content="▶ Start"/>
                <Button x:Name="btnStop" Style="{StaticResource ToolButton}" Content="■ Stop"/>
                <Button x:Name="btnRestart" Style="{StaticResource ToolButton}" Content="⟳ Restart"/>
                <Button x:Name="btnTerminal" Style="{StaticResource ToolButton}" Content="&gt;_ Terminal"/>
                <Button x:Name="btnOpenFiles" Style="{StaticResource ToolButton}" Content="📁 Files" ToolTip="Open \\wsl.localhost\&lt;name&gt; in Explorer (starts the instance if stopped)"/>
                <Border Style="{StaticResource ToolSep}"/>
                <Button x:Name="btnDelete" Style="{StaticResource ToolButton}" Content="🗑 Delete" Foreground="{StaticResource DangerBrush}"/>
                <Border Style="{StaticResource ToolSep}"/>
                <Button x:Name="btnRefresh" Style="{StaticResource ToolButton}" Content="↻ Refresh"/>
                <Button x:Name="btnShutdownAll" Style="{StaticResource ToolButton}" Content="⏻ Shutdown WSL" ToolTip="wsl --shutdown (stops all instances and the VM)"/>
                <Button x:Name="btnDefaultProfile" Style="{StaticResource ToolButton}" Content="⚙ Default profile" ToolTip="Default CPU/RAM/swap used to fill blanks in instance profiles"/>
                <Button x:Name="btnStorage" Style="{StaticResource ToolButton}" Content="🗄 Storage location" ToolTip="Default folder where new instances are created"/>
            </WrapPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="txtProfile" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="txtStorage" Foreground="{StaticResource MutedBrush}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <ProgressBar x:Name="pbBusy" Width="90" Height="12" IsIndeterminate="True" Visibility="Collapsed"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="400" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="gridInstances" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="30" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="" Binding="{Binding DefaultMark}" Width="36"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayLabel}" Width="2*"/>
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="OS" Binding="{Binding OS}" Width="1.5*"/>
                    <DataGridTextColumn Header="WSL" Binding="{Binding Version}" Width="40"/>
                    <DataGridTextColumn Header="Disk" Binding="{Binding SizeText}" Width="75"/>
                    <DataGridTextColumn Header="Profile" Binding="{Binding ProfileText}" Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="panelDetail" IsEnabled="False">
                    <GroupBox Header="Identity">
                        <StackPanel>
                            <TextBlock Text="Display name"/>
                            <TextBox x:Name="txtDisplayName"/>
                            <TextBlock Text="Description"/>
                            <TextBox x:Name="txtDescription" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Text="Real WSL name (used by wsl -d)"/>
                            <DockPanel>
                                <Button x:Name="btnRename" DockPanel.Dock="Right" Content="Rename" Margin="6,2,0,6" ToolTip="Instance must be stopped"/>
                                <TextBox x:Name="txtRealName"/>
                            </DockPanel>
                            <TextBlock x:Name="txtInfo" Style="{StaticResource Hint}" FontFamily="Consolas"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Operating system">
                        <DockPanel>
                            <Button x:Name="btnRefreshOs" DockPanel.Dock="Right" Content="Detect" Margin="6,0,0,0" VerticalAlignment="Top"
                                    ToolTip="Reads /etc/os-release (starts the instance if stopped)"/>
                            <TextBlock x:Name="txtOs" TextWrapping="Wrap"/>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Header="Resources (VM profile)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="WSL2 runs all instances in one VM. Starting this instance applies its profile to .wslconfig and restarts WSL when it differs from the active one. Leave all blank to use whatever is active; blanks in a partial profile come from the default profile."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="lblCpu" Text="CPUs"/>
                                    <TextBox x:Name="txtCpu"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Memory"/>
                                    <TextBox x:Name="txtMem" ToolTip="e.g. 8GB"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Swap"/>
                                    <TextBox x:Name="txtSwap" ToolTip="e.g. 4GB, 0 = no swap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <Button x:Name="btnSave" Content="💾 Save name, description &amp; profile" HorizontalAlignment="Stretch" Margin="0,0,0,10" Padding="6"/>

                    <GroupBox Header="Disk">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Maximum virtual disk size, e.g. 256GB. Instance must be stopped."/>
                            <DockPanel>
                                <Button x:Name="btnResize" DockPanel.Dock="Right" Content="Resize" Margin="6,2,0,6"/>
                                <TextBox x:Name="txtDiskSize"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="More">
                        <WrapPanel>
                            <Button x:Name="btnSetDefault" Content="★ Set as default" Margin="0,0,6,6"/>
                            <Button x:Name="btnOpenFolder" Content="VHDX folder" Margin="0,0,6,6"/>                        </WrapPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
